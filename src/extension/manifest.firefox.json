{
  "manifest_version": 2,
  "name": "OmniTouch",
  "version": "1.0.0",
  "description": "Cross-browser human-grade AI web harness and neural extension",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "<all_urls>",
    "http://127.0.0.1:8765/*",
    "ws://127.0.0.1:8765/*"
  ],
  "background": {
    "scripts": ["service_worker.js"]
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_title": "OmniTouch Control"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "omnitouch@neuralbridge.internal",
      "strict_min_version": "109.0"
    }
  }
}
